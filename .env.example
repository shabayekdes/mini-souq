# Copy to `.env` for local development:  cp .env.example .env
# `.env` is git-ignored. Never commit real values. In production (Railway),
# set these as service variables instead of using a file.

# --- Core ---------------------------------------------------------------
# 1 for local development only. Defaults to 0 (production) when unset.
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG=0. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
# Comma-separated. On Railway the generated domain (RAILWAY_PUBLIC_DOMAIN)
# is added automatically; list custom domains here.
DJANGO_ALLOWED_HOSTS=
# Comma-separated full origins, e.g. https://shop.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database -----------------------------------------------------------
# Required when DJANGO_DEBUG=0. Leave empty in development to use db.sqlite3.
# Example: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=
# Set to 1 to force sslmode=require (alternative to ?sslmode= in the URL).
DATABASE_SSL_REQUIRE=0
# Seconds to keep DB connections open (0 = close after each request).
CONN_MAX_AGE=300

# --- HTTPS / security (defaults shown are the production defaults) -------
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_SECURE_COOKIES=1
# DJANGO_TRUST_X_FORWARDED_PROTO=1
# Opt-in; start small (3600) and increase once HTTPS is confirmed.
# DJANGO_SECURE_HSTS_SECONDS=0
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
# DJANGO_SECURE_HSTS_PRELOAD=0

# --- Email --------------------------------------------------------------
# Defaults to the console backend when DJANGO_DEBUG=1, SMTP otherwise.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=
# Use an app-specific password; never commit it.
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Receives 500-error reports when DJANGO_DEBUG=0.
ADMIN_USER_NAME=Admin user
ADMIN_USER_EMAIL=

# --- Accounts -----------------------------------------------------------
# none | optional | mandatory  ("mandatory" requires working SMTP)
ACCOUNT_EMAIL_VERIFICATION=none

# --- Container runtime --------------------------------------------------
# PORT=8000
# Set to 0 to skip `migrate` on container start.
# DJANGO_MIGRATE_ON_START=1
# Gunicorn worker count.
# WEB_CONCURRENCY=1
# DJANGO_LOG_LEVEL=INFO
